# ============================
# Stage 1: build client + RTS
# ============================
FROM node:18-bullseye AS clientbuild
WORKDIR /src

# Copia o repositório
COPY . .

# Yarn 3.5.1 via Corepack
RUN corepack enable && corepack prepare yarn@3.5.1 --activate && yarn -v

# Build do client (usa yarn 3)
RUN cd app/client \
 && yarn install \
 && yarn build

# Build do RTS
RUN cd app/client/packages/rts \
 && yarn install \
 && yarn build

# ============================
# Stage 2: imagem final
# ============================
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV IN_DOCKER=1

# Dependências mínimas de runtime
RUN apt-get update \
 && apt-get install -y ca-certificates curl gnupg \
 && rm -rf /var/lib/apt/lists/*

# Estrutura de runtime do Appsmith (seu repo possui deploy/docker/fs)
COPY deploy/docker/fs/ /

# Artefatos compilados do stage 1
COPY --from=clientbuild /src/app/client/build /editor/
COPY --from=clientbuild /src/app/client/packages/rts/dist /rts/

EXPOSE 80
ENTRYPOINT ["/opt/appsmith/entrypoint.sh"]
