# =====================================================================
# Dockerfile.zgd - Build da imagem customizada "Zek Galarza Dashboard"
# =====================================================================

# Imagem base
FROM debian:bookworm-slim

# Variáveis
ENV APPSMITH_HOME=/appsmith-stacks
ENV DEBIAN_FRONTEND=noninteractive

# Instala dependências básicas
RUN apt-get update && \
    apt-get install -y \
    curl wget unzip git gnupg software-properties-common \
    openjdk-17-jdk maven nodejs npm yarn \
    tar zstd python3 python3-pip openssh-client && \
    rm -rf /var/lib/apt/lists/*

# Diretório de trabalho
WORKDIR /appsmith

# Copia arquivos necessários do Appsmith
COPY ./app/server ./server
COPY ./app/client ./client
COPY ./deploy/docker/fs/opt /opt
COPY ./deploy/docker/fs/etc /etc

# =====================================================================
# Build do CLIENTE (React)
# =====================================================================
WORKDIR /appsmith/client
RUN yarn install --network-timeout 100000 && \
    yarn build

# =====================================================================
# Build do SERVIDOR (Java Spring Boot)
# =====================================================================
WORKDIR /appsmith/server
RUN mvn clean package -DskipTests

# =====================================================================
# Finalização
# =====================================================================
WORKDIR /appsmith
EXPOSE 8080

CMD ["java", "-jar", "server/target/server-1.0-SNAPSHOT.jar"]
