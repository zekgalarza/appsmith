# ============================
# Stage 1: build client + RTS
# ============================
FROM node:18-bullseye AS clientbuild

# Toolchain para pacotes nativos (node-gyp etc.)
RUN apt-get update && apt-get install -y \
    build-essential python3 make g++ git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Copia o repo
COPY . .

# Habilita Yarn 3.5.1 e fixa no projeto
RUN corepack enable && corepack prepare yarn@3.5.1 --activate && yarn -v && node -v

# Cria .yarnrc.yml do projeto (evita 'yarn config set' falhar)
# Usamos nodeLinker: node-modules para maior compatibilidade em CI
RUN printf "nodeLinker: node-modules\nenableGlobalCache: true\n" > .yarnrc.yml \
 && mkdir -p .yarn/releases \
 && yarn set version 3.5.1

# (Opcional) listar workspaces para debug; não falhar o build se der erro
RUN yarn workspaces list --json || true

# Instala dependências (com cache + retry)
RUN --mount=type=cache,target=/root/.cache/yarn \
    --mount=type=cache,target=/root/.cache/npm \
    yarn install || yarn install

# Faz o build do monorepo (gera app/client/build e packages/rts/dist)
RUN yarn build

# ============================
# Stage 2: imagem final
# ============================
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV IN_DOCKER=1

RUN apt-get update \
 && apt-get install -y ca-certificates curl gnupg \
 && rm -rf /var/lib/apt/lists/*

# Estrutura de runtime do Appsmith
COPY deploy/docker/fs/ /

# Artefatos do build
COPY --from=clientbuild /src/app/client/build /editor/
COPY --from=clientbuild /src/app/client/packages/rts/dist /rts/

EXPOSE 80
ENTRYPOINT ["/opt/appsmith/entrypoint.sh"]
