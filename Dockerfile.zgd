# ============================
# Stage 1: build client + RTS
# ============================
FROM node:18-bullseye AS clientbuild
WORKDIR /src

# Copia o repo inteiro
COPY . .

# Habilita Yarn 3.5.1 via Corepack
RUN corepack enable && corepack prepare yarn@3.5.1 --activate && yarn -v

# Instala dependências no monorepo (root)
RUN yarn install

# Faz o build completo (gera client + rts + server assets)
RUN yarn build

# ============================
# Stage 2: imagem final
# ============================
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV IN_DOCKER=1

# Dependências mínimas
RUN apt-get update \
 && apt-get install -y ca-certificates curl gnupg \
 && rm -rf /var/lib/apt/lists/*

# Estrutura runtime Appsmith
COPY deploy/docker/fs/ /

# Copia apenas os artefatos gerados no build
COPY --from=clientbuild /src/app/client/build /editor/
COPY --from=clientbuild /src/app/client/packages/rts/dist /rts/

EXPOSE 80
ENTRYPOINT ["/opt/appsmith/entrypoint.sh"]
