# --------- Stage 1: build do client + RTS ----------
FROM node:18-bullseye AS clientbuild
WORKDIR /src

# Copia todo o repositório
COPY . .

# Ativa Yarn 3.5.1 no container
RUN corepack enable && corepack prepare yarn@3.5.1 --activate

# Instala dependências e compila o client
RUN cd app/client \
 && yarn install \
 && yarn build

# Compila RTS (pacote em app/client/packages/rts)
RUN cd app/client/packages/rts \
 && yarn install \
 && yarn build

# --------- Stage 2: imagem final ----------
ARG BASE=debian:bookworm-slim
FROM ${BASE}

ENV IN_DOCKER=1

# Dependências mínimas
RUN apt-get update \
 && apt-get install -y ca-certificates curl gnupg \
 && rm -rf /var/lib/apt/lists/*

# Copia estrutura de runtime (igual Appsmith CE)
COPY deploy/docker/fs/ /

# Copia artefatos do build (client + RTS)
COPY --from=clientbuild /src/app/client/build /editor/
COPY --from=clientbuild /src/app/client/packages/rts/dist /rts/

# Porta padrão
EXPOSE 80

# Usa o entrypoint padrão do Appsmith CE
ENTRYPOINT ["/opt/appsmith/entrypoint.sh"]
